<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/sh_field" />
            <stroke android:width="1dp" android:color="@color/sh_disabled" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33E8A33D">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/sh_field" />
                    <stroke android:width="1.5dp" android:color="@color/sh_amber" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>