<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1117">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안심 귀가"
            android:textSize="20sp"
            android:textColor="#F0F2F8"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 지도 -->
    <com.kakao.vectormap.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- 하단 패널 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1A1D27">

        <!-- 목적지 검색 -->
        <EditText
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="목적지 검색..."
            android:inputType="text"
            android:textColor="#F0F2F8"
            android:textColorHint="#555A70"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- 예상 소요 시간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="예상 소요 시간"
                android:textColor="#8B90A7"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15분"
                android:textColor="#4F7EF8"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="5"
            android:max="60"
            android:progress="15"
            android:layout_marginBottom="16dp"/>

        <!-- 귀가 시작 버튼 -->
        <Button
            android:id="@+id/btnStartTrip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="귀가 시작"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4F7EF8"/>
    </LinearLayout>

</LinearLayout>