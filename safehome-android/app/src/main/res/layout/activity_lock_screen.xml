<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#CC0F1117"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="64sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="긴급 SOS"
        android:textSize="32sp"
        android:textColor="#F87171"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="음성 SOS가 감지됐어요"
        android:textSize="16sp"
        android:textColor="#F0F2F8"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textSize="48sp"
        android:textColor="#F87171"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSosCall"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="📞 112 신고"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#F87171"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="취소 (오감지)"
        android:textSize="16sp"
        android:textColor="#8B90A7"
        android:backgroundTint="#1E2130"/>

</LinearLayout>